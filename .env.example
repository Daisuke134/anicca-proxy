# Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Slack Client Secret (Required for OAuth)
SLACK_CLIENT_SECRET=your_slack_client_secret_here

# ACI API Key (Required for ACI MCP)
ACI_API_KEY=your_aci_api_key_here

# ACI Linked Account Owner ID (Optional)
ACI_LINKED_ACCOUNT_OWNER_ID=your_linked_account_owner_id_here