# Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Slack OAuth Configuration (Required for Slack integration)
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_STATE_SECRET=your_slack_state_secret_here
SLACK_REDIRECT_URI=http://localhost:3000/api/slack/oauth-callback

# Slack Token Encryption Key (Optional - will be auto-generated if not provided)
SLACK_TOKEN_ENCRYPTION_KEY=your_32_byte_encryption_key_here

# ACI API Key (Required for ACI MCP)
ACI_API_KEY=your_aci_api_key_here

# ACI Linked Account Owner ID (Optional)
ACI_LINKED_ACCOUNT_OWNER_ID=your_linked_account_owner_id_here